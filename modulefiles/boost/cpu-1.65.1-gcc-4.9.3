#%Module######################################################################
#
# boost modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use boost version 1.65.1"
}


source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]
set sys     [uname sysname]
set version cpu-1.65.1-gcc-4.9.3
set tool    boost
module-whatis "Boost provides free peer-reviewed portable C++ source libraries.

Boost emphasizes libraries that work well with the C++ Standard Library. Boost
libraries are intended to be widely useful, and usable across a broad spectrum
of applications. The Boost license encourages both commercial and
non-commercial use.

For further information see http://www.boost.org/

Compiled with gcc/4.8.5
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}
# Load dependencies.
load_unless_already_loaded gcc/cpu-4.9.3

if {! [module-info mode whatis] } {
setenv       MAALI_BOOST_HOME     $APP_ROOT/boost/1.65.1/cpu/gcc/4.9.3
setenv       BOOST_ROOT           "$APP_ROOT/boost/1.65.1/cpu/gcc/4.9.3"
prepend-path CPATH                $APP_ROOT/boost/1.65.1/cpu/gcc/4.9.3/include
prepend-path CPLUS_INCLUDE_PATH   $APP_ROOT/boost/1.65.1/cpu/gcc/4.9.3/include
prepend-path C_INCLUDE_PATH       $APP_ROOT/boost/1.65.1/cpu/gcc/4.9.3/include
prepend-path LD_LIBRARY_PATH      $APP_ROOT/boost/1.65.1/cpu/gcc/4.9.3/lib
prepend-path LIBRARY_PATH         $APP_ROOT/boost/1.65.1/cpu/gcc/4.9.3/lib
}


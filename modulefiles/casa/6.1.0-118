#%Module -*- mode: tcl -*-

proc ModulesHelp { } {
    puts stderr "Prepends casa v5.0.0"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set software casa
set version 6.1.0-118

set root $APP_ROOT/casa-6.1.0-118

fail_if_path_does_not_exist $root

# Load dependencies.
#load_unless_already_loaded libpng/cpu-1.2.59-gcc-4.8.5

# Prepend the paths.
prepend-path PATH             $root/bin
#prepend-path LD_LIBRARY_PATH  $root/lib
#prepend-path CPATH            $root/include


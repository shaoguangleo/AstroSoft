#%Module -*- mode: tcl -*-

proc ModulesHelp { } {
  puts stderr "Prepends DiFX"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set root $SOFTWARE_ROOT/difx/difx-2.8.1

# Check that the root directory actually exists.
if { ! [file exists $root] } {
    puts stderr "$root doesn't exist! Exiting."
    exit 1
}


# Load dependencies.
#. $SOFTWARE_ROOT/difx/setup.bash.v2.8.1
# Prepend the paths.
prepend-path PATH              $root/bin
prepend-path LD_LIBRARY_PATH   $root/lib
setenv       DIFXROOT        $root
setenv       DIFXDOC    $root/doc
#setenv       DIFXCAT     $root/cat


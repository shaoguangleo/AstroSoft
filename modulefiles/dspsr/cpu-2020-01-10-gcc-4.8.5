#%Module######################################################################
#
# dspsr modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use DSPSR 2020-01-10 (gcc 4.8.5)"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set sys     [uname sysname]
set version cpu-2020-01-10-gcc-4.8.5
set tool    dspsr
module-whatis "DSPSR digital signal processing for pulsar astronomy, built with gcc 4.8.5.

Install prefix: $APP_ROOT/dspsr/2020-01-10/cpu/gcc/4.8.5/
Tempo2 runtime: $APP_ROOT/psrchive/2020-01-10/cpu/gcc/4.8.5/src/tempo2

For further information see http://dspsr.sourceforge.net/
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

load_unless_already_loaded cfitsio/cpu-3450
load_unless_already_loaded fftw/cpu-3.3.8
load_unless_already_loaded hdf5/cpu-1.10.4
load_unless_already_loaded pgplot/cpu-5.2
#load_unless_already_loaded tempo2/cpu-master
load_unless_already_loaded psrdata/cpu-master-gcc-4.8.5
load_unless_already_loaded psrchive/cpu-2020-01-10-gcc-4.8.5

if {! [module-info mode whatis] } {
setenv       TEMPO2               $APP_ROOT/psrchive/2020-01-10/cpu/gcc/4.8.5/src/tempo2
prepend-path PATH                 $APP_ROOT/dspsr/2020-01-10/cpu/gcc/4.8.5/bin
prepend-path CPATH                $APP_ROOT/dspsr/2020-01-10/cpu/gcc/4.8.5/include
prepend-path LIBRARY_PATH         $APP_ROOT/dspsr/2020-01-10/cpu/gcc/4.8.5/lib
prepend-path LD_LIBRARY_PATH      $APP_ROOT/dspsr/2020-01-10/cpu/gcc/4.8.5/lib
}


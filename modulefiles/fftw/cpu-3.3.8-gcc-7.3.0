#%Module######################################################################
#
# fftw3 modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use fftw version 3.8.8"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set sys     [uname sysname]
set version cpu-3.8.8-gcc-7.3.0
set tool    fftw
module-whatis "FFTW is a C subroutine library for computing the discrete Fourier transform (DFT) in one or more dimensions, of arbitrary input size, and of both real and complex data (as well as of even/odd data, i.e. the discrete cosine/sine transforms or DCT/DST). We believe that FFTW, which is free software, should become the FFT library of choice for most applications.

For further information see http://www.fftw.org/

Compiled with gcc/7.3.0
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

load_unless_already_loaded gcc/cpu-7.3.0

if {! [module-info mode whatis] } {
setenv       MAALI_FFTW_HOME    $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0
setenv       FFTW_ROOT          "$APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0"
prepend-path CPATH              $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0/include
prepend-path FCPATH             $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0/include
prepend-path FPATH              $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0/include
prepend-path LD_LIBRARY_PATH    $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0/lib
prepend-path LIBRARY_PATH       $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0/lib
prepend-path MANPATH            $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0/share/man
prepend-path PKG_CONFIG_PATH    $APP_ROOT/fftw3/3.3.8/cpu/gcc/7.3.0/lib/pkgconfig
}


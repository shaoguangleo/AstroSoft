#%Module -*- mode: tcl -*-

proc ModulesHelp { } {
  puts stderr "Prepends miriad"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set software miriad
set version cpu-2007
set root $SOFTWARE_ROOT/miriad

# Check that the root directory actually exists.
if { ! [file exists $root] } {
    puts stderr "$root doesn't exist! Exiting."
    exit 1
}


# Load dependencies.
#source $BEEGFS_ROOT/miriad/MIRRC.sh
# Prepend the paths.
prepend-path PATH              $root/linux64/bin
prepend-path LD_LIBRARY_PATH   $root/linux64/lib
setenv       MIR        $root
setenv       MIRPDOC    $root/doc
setenv       MIRCAT     $root/cat


#%Module######################################################################
source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]
#
# presto modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use PRESTO master tree (cpu-master-new)"
}

set sys     [uname sysname]
set version cpu-master-new
set tool    presto
module-whatis "PRESTO master tree.

PRESTO=$APP_ROOT/presto-master

For further information see https://github.com/scottransom/presto
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

set PRESTO $APP_ROOT/presto-master

if {! [module-info mode whatis] } {
setenv       PRESTO               $PRESTO 
prepend-path PATH                 $PRESTO/bin
prepend-path CPATH                $PRESTO/include
prepend-path LIBRARY_PATH         $PRESTO/lib
prepend-path LD_LIBRARY_PATH      $PRESTO/lib
prepend-path PYTHONPATH           $PRESTO/lib/python
}


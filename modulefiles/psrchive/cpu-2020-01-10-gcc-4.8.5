#%Module######################################################################
#
# psrchive modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use PSRCHIVE 2020-01-10 (gcc 4.8.5)"
}

source /home/app/modulefiles/common.tcl

set sys     [uname sysname]
set version cpu-2020-01-10-gcc-4.8.5
set tool    psrchive
module-whatis "PSRCHIVE pulsar data analysis suite, built with gcc 4.8.5.

Install prefix: /home/app/psrchive/2020-01-10/cpu/gcc/4.8.5/

For further information see http://psrchive.sourceforge.net/
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

load_unless_already_loaded cfitsio/cpu-3450
load_unless_already_loaded fftw/cpu-3.3.8
load_unless_already_loaded pgplot/cpu-5.2
load_unless_already_loaded tempo2/cpu-psrchive

if {! [module-info mode whatis] } {
prepend-path PATH                 /home/app/psrchive/2020-01-10/cpu/gcc/4.8.5/bin
prepend-path CPATH                /home/app/psrchive/2020-01-10/cpu/gcc/4.8.5/include
prepend-path LIBRARY_PATH         /home/app/psrchive/2020-01-10/cpu/gcc/4.8.5/lib
prepend-path LD_LIBRARY_PATH      /home/app/psrchive/2020-01-10/cpu/gcc/4.8.5/lib
}


#%Module######################################################################
#
# python modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use python version 2.7.14"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set sys     [uname sysname]
set version cpu-2.7.14-gcc-7.3.0
set tool    python
module-whatis "Python is a clear and powerful object-oriented programming language, comparable
to Perl, Ruby, Scheme, or Java.

For further information see https://www.python.org/

Compiled with gcc/7.3.0
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}


load_unless_already_loaded gcc/cpu-7.3.0

if {! [module-info mode whatis] } {
setenv       MAALI_PYTHON_HOME          $APP_ROOT/python/2.7.14/cpu/gcc/7.3.0
setenv       MAALI_PYTHON_LIBDIR        "lib"
setenv       MAALI_PYTHON_LIB_VERSION   "2.7"
prepend-path LD_LIBRARY_PATH            $APP_ROOT/python/2.7.14/cpu/gcc/7.3.0/lib
prepend-path MANPATH                    $APP_ROOT/python/2.7.14/cpu/gcc/7.3.0/share/man
prepend-path PATH                       $APP_ROOT/python/2.7.14/cpu/gcc/7.3.0/bin
prepend-path CPATH                      $APP_ROOT/python/2.7.14/cpu/gcc/7.3.0/include/python2.7
prepend-path PKG_CONFIG_PATH            $APP_ROOT/python/2.7.14/cpu/gcc/7.3.0/lib/pkgconfig
prepend-path PYTHONPATH                 "$APP_ROOT/python/2.7.14/cpu/gcc/7.3.0/lib/python2.7/site-packages"
setenv       PYTHON_DIR                 "$APP_ROOT/python/2.7.14/cpu/gcc/7.3.0"
setenv       PYTHON_VERSION             "2.7.14"
}


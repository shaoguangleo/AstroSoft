#%Module######################################################################
source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]
#
# python modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use python version 2.7.14"
}

set sys     [uname sysname]
set version cpu-2.7.14-presto-acc
set tool    python
module-whatis "Python is a clear and powerful object-oriented programming language, comparable
to Perl, Ruby, Scheme, or Java.

For further information see https://www.python.org/

Compiled with gcc/4.8.5
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

if {! [module-info mode whatis] } {
setenv       MAALI_PYTHON_HOME          $APP_ROOT/python/2.7.14/cpu/presto_acc
setenv       MAALI_PYTHON_LIBDIR        "lib"
setenv       MAALI_PYTHON_LIB_VERSION   "2.7"
prepend-path LD_LIBRARY_PATH            $APP_ROOT/python/2.7.14/cpu/presto_acc/lib
prepend-path MANPATH                    $APP_ROOT/python/2.7.14/cpu/presto_acc/share/man
prepend-path PATH                       $APP_ROOT/python/2.7.14/cpu/presto_acc/bin
prepend-path CPATH                      $APP_ROOT/python/2.7.14/cpu/presto_acc/include/python2.7
prepend-path PKG_CONFIG_PATH            $APP_ROOT/python/2.7.14/cpu/presto_acc/lib/pkgconfig
prepend-path PYTHONPATH                 "$APP_ROOT/python/2.7.14/cpu/presto_acc/lib/python2.7/site-packages"
setenv       PYTHON_DIR                 "$APP_ROOT/python/2.7.14/cpu/presto_acc"
setenv       PYTHON_VERSION             "2.7.14"
}


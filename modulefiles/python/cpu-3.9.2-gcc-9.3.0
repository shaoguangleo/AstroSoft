#%Module######################################################################
#
# python modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use python version 3.8.0"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set sys     [uname sysname]
set version cpu-3.9.2-gcc-9.3.0
set tool    python
module-whatis "Python is a clear and powerful object-oriented programming language, comparable
to Perl, Ruby, Scheme, or Java.

For further information see https://www.python.org/

Compiled with gcc/9.3.0
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}
# Load dependencies.
load_unless_already_loaded gcc/9.3.0
if {! [module-info mode whatis] } {
setenv       MAALI_PYTHON_HOME          $SOFTWARE_ROOT/python/cpu/3.9.2
setenv       MAALI_PYTHON_LIBDIR        "lib"
setenv       MAALI_PYTHON_LIB_VERSION   "3.9"
prepend-path LD_LIBRARY_PATH            $SOFTWARE_ROOT/python/cpu/3.9.2/lib
prepend-path MANPATH                    $SOFTWARE_ROOT/python/cpu/3.9.2/share/man
prepend-path PATH                       $SOFTWARE_ROOT/python/cpu/3.9.2/bin
prepend-path CPATH                      $SOFTWARE_ROOT/python/cpu/3.9.2/include/python3.9
prepend-path PKG_CONFIG_PATH            $SOFTWARE_ROOT/python/cpu/3.9.2/lib/pkgconfig
prepend-path PYTHONPATH                 "$SOFTWARE_ROOT/python/cpu/3.9.2/lib/python3.9/site-packages"
setenv       PYTHON_DIR                 "$SOFTWARE_ROOT/python/cpu/3.9.2"
setenv       PYTHON_VERSION             "3.9.2"
}


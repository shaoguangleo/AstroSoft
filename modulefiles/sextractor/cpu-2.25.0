#%Module -*- mode: tcl -*-

proc ModulesHelp { } {
    puts stderr "Prepends libsla"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set software sextractor
set version 2.25.0
set root $SOFTWARE_ROOT/$software/$version/cpu

# Check that the root directory actually exists.
if { ! [file exists $root] } {
    puts stderr "$root doesn't exist! Exiting."
    exit 1
}

# Load dependencies.

# MWA built.
load_unless_already_loaded fftw/cpu-3.8.8
load_unless_already_loaded gcc/7.3.0

# Prepend the paths.
#prepend-path LD_LIBRARY_PATH  $root/lib
prepend-path PATH            $root/bin


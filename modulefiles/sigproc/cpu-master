#%Module######################################################################
source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]
#
# sigproc modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use SIGPROC (cpu-master)"
}

set sys     [uname sysname]
set version cpu-master
set tool    sigproc
module-whatis "SIGPROC pulsar data tools.

Programs: $APP_ROOT/sigproc/bin

For further information see https://github.com/evanocathain/sigproc.git
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

if {! [module-info mode whatis] } {
prepend-path PATH                 $APP_ROOT/sigproc/bin
setenv  OSTYPE                    linux
}


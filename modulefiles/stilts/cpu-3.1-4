#%Module -*- mode: tcl -*-
source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

proc ModulesHelp { } {
    puts stderr "Prepends stilts"
}

set software stilts
set root $SOFTWARE_ROOT/$software

# Check that the root directory actually exists.
if { ! [file exists $root] } {
    puts stderr "$root doesn't exist! Exiting."
    exit 1
}

# Load dependencies.

# set-alias stilts "java -jar ${root}/stilts.jar"
prepend-path PATH $root/bin


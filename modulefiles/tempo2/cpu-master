#%Module######################################################################
#
# tempo2 modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the independent Tempo2 install (cpu-master)"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set sys     [uname sysname]
set version cpu-master
set tool    tempo2
module-whatis "Independent Tempo2 install.

TEMPO2=$APP_ROOT/tempo2/cpu

The prototype listing confirms $APP_ROOT/tempo2/ exists. Confirm that bin, include, lib and the runtime data live under the cpu/ subdirectory before relying on this module.

For further information see https://bitbucket.org/psrsoft/tempo2
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

load_unless_already_loaded cfitsio/cpu-3450
load_unless_already_loaded pgplot/cpu-5.2

if {! [module-info mode whatis] } {
prepend-path PATH                 $APP_ROOT/tempo2/cpu/bin
prepend-path CPATH                $APP_ROOT/tempo2/cpu/include
prepend-path LIBRARY_PATH         $APP_ROOT/tempo2/cpu/lib
prepend-path LD_LIBRARY_PATH      $APP_ROOT/tempo2/cpu/lib
setenv       TEMPO2               $APP_ROOT/tempo2/cpu
}


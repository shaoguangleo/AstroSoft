#%Module######################################################################
#
# wcslib modulefile
#
proc ModulesHelp { } {
  puts stderr "Sets up the paths you need to use wcslib version 6.2"
}
source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set sys     [uname sysname]
set version gpu-6.2
set tool    wcslib
module-whatis "The FITS World Coordinate System (WCS) standard defines keywords and usage that provide for the description of astronomical coordinate systems in a FITS image header.

For further information see http://www.atnf.csiro.au/people/mcalabre/WCS

Compiled with gcc/4.8.5 
"
if { [ module-info mode load ] } {
  if { [is-loaded $tool] && ! [is-loaded $tool/$version] } {
    module unload $tool
  }
}

# Load dependencies.
load_unless_already_loaded cfitsio/gpu-3450 
load_unless_already_loaded pgplot/gpu-5.2

if {! [module-info mode whatis] } {
setenv       MAALI_WCSLIB_HOME $SOFTWARE_ROOT/wcslib/gpu
prepend-path LD_LIBRARY_PATH   $SOFTWARE_ROOT/wcslib/gpu/lib
prepend-path CPATH             $SOFTWARE_ROOT/wcslib/gpu/include
prepend-path PATH              $SOFTWARE_ROOT/wcslib/gpu/bin
setenv       WCSLIB_ROOT       "$SOFTWARE_ROOT/wcslib/gpu"
}


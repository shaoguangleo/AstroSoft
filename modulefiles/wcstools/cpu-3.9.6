#%Module -*- mode: tcl -*-

proc ModulesHelp { } {
    puts stderr "Prepends wcstools 2.38.0"
}

source [file join [file dirname [file dirname $::ModulesCurrentModulefile]] common.tcl]

set software wcstools
set version cpu-3.9.6
set root $SOFTWARE_ROOT/wcstools-3.9.6

fail_if_path_does_not_exist $root
swap_module_if_version_does_not_match $software $version

# Prepend the paths.
prepend-path PATH $root/bin

